# Postgres
DATABASE_URL=postgresql://howtojump:howtojump@localhost:5432/howtojump

# osu! OAuth application: https://osu.ppy.sh/home/account/edit#oauth
# The same credentials cover both user login and beatmap lookups.
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=

# Auth.js. Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# osu! user IDs that should get the admin role on first sign in, comma separated.
BOOTSTRAP_ADMINS=

# Shared secret for POST /api/sync/run so only the worker can trigger a sweep.
SYNC_TOKEN=
