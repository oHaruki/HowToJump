# Postgres
DATABASE_URL=postgresql://howtojump:howtojump@localhost:5435/howtojump

# osu! OAuth application: https://osu.ppy.sh/home/account/edit#oauth
# The same credentials cover both user login and beatmap lookups.
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=

# Auth.js. Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:6500

# osu! user IDs that should get the admin role on first sign in, comma separated.
BOOTSTRAP_ADMINS=

# Shared secret for POST /api/sync/run so only the worker can trigger a sweep.
SYNC_TOKEN=

# Discord, all optional. The commands and the announcements stay off until
# these are set.
# ID and public key: developer portal, your application, General Information.
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
# The bot's own token, which posts the announcements and registers the
# commands. Invite the bot with Send Messages and Embed Links, nothing more.
DISCORD_BOT_TOKEN=
# Only needed on the machine that runs npm run discord:commands.
DISCORD_GUILD_ID=
# Where each announcement goes. Turn on Developer Mode in Discord, then right
# click a channel and Copy Channel ID. Each is posted only when it is named,
# so any of them can be left blank.
# Every score the site imports.
DISCORD_SCORES_CHANNEL_ID=
# Every first place taken, overall and on a map.
DISCORD_RECORDS_CHANNEL_ID=
# Every map added to the bank.
DISCORD_MAPS_CHANNEL_ID=
