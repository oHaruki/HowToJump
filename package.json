{
  "name": "project-aim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 6500",
    "build": "next build",
    "start": "next start -p 6500",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed.ts",
    "db:deploy": "tsx src/db/deploy.ts",
    "seed:examples": "tsx src/db/seed-examples.ts",
    "sync": "tsx src/db/sync-cli.ts",
    "discord:commands": "tsx src/db/discord-commands.ts",
    "discord:presence": "tsx src/db/discord-presence.ts",
    "levels:rebuild": "tsx src/db/rebuild-levels.ts",
    "test": "node --import tsx --test src/**/*.test.ts",
    "build:check": "cross-env NEXT_DIST_DIR=.next-check next build"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.5",
    "next": "^15.5.4",
    "next-auth": "^5.0.0-beta.29",
    "postgres": "^3.4.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
